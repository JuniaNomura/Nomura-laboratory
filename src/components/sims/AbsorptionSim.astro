---
// 吸収線シミュレーター(研究内容「光原子・分子時計」用)。
// 2つの準位だけを持つ原子1個に、光子を1個ずつ当てて、吸収線ができる様子を見る。
// 研究テーマの frontmatter に simulator: "absorption" と書くと、研究内容のページに表示される。
---

<div class="sim" data-sim-root="absorption">
  <p class="sim__title">吸収線シミュレーター: 原子は、決まった周波数の光だけを吸収する</p>

  <div class="sim__controls">
    <label class="sim__field">
      <span>光の周波数(遷移周波数 f₀ からのずれ): <output data-role="freq-out">0.0</output></span>
      <input data-role="freq" type="range" min="-4" max="4" step="0.1" value="-2" />
    </label>
    <label class="sim__field">
      <span>上準位の寿命: <output data-role="life-out">0.10</output></span>
      <input data-role="life" type="range" min="0.05" max="0.4" step="0.01" value="0.1" />
    </label>
  </div>

  <div class="sim__buttons">
    <button type="button" data-role="sweep">周波数を自動で動かす(掃引)</button>
    <button type="button" data-role="clear">記録を消す</button>
  </div>

  <canvas
    data-role="canvas"
    width="900"
    height="430"
    role="img"
    aria-label="左上に原子のエネルギー準位、右上に光子が原子を通って検出器へ向かう様子、下に光の周波数ごとの、検出器に届いた光子の割合"
  ></canvas>
  <p class="sim__caption">
    左上は、原子の2つの準位です。準位のエネルギーの差を、プランク定数 h で割ったものが、遷移周波数 f₀ です。赤い矢印は、光子1個のエネルギー(h×周波数)で、矢印の先が上準位に届くと、光子は吸収されます。右上では、光子を1個ずつ原子に当てています。吸収された光子は検出器に届かず、原子は寿命のあいだ上準位にとどまったあと、別の向きに光を出して下準位に戻ります。下のグラフは、周波数ごとに、検出器に届いた光子の割合を記録したものです。破線は、光子を無限に送ったときの曲線です。周波数や寿命の目盛りは、単位のない仮の値です。
  </p>

  <p class="sim__readout" data-role="readout" aria-live="polite"></p>

  <p class="sim__caption">
    実際の例: ルビジウム原子の波長780 nmの遷移は、周波数が約384 THz、上準位の寿命が約26 ns、吸収線の幅が約6 MHzです。幅は、周波数の約6000万分の1しかありません。光格子時計に使われるストロンチウム原子の遷移は、寿命が100秒以上、幅が約0.001 Hzと、さらに桁違いに細くなります。なお、このシミュレーターは、止まっている原子1個を考えています。実際の気体では、原子が熱で飛び回るため、吸収線はこれよりずっと太く見えます(ドップラー広がり)。それを取り除いて本来の細い線を見るのが、飽和吸収分光法などの技術です。
  </p>
</div>

<script>
  const F_MAX = 4; // 周波数の表示範囲(遷移周波数からのずれ、±)
  const BIN = 0.1; // 記録する周波数の刻み
  const BINS = Math.round((2 * F_MAX) / BIN) + 1;
  const PEAK = 0.9; // 周波数がぴったり合ったときに、光子が吸収される確率
  const LIFE_SECONDS = 5; // 寿命1あたりの、画面上での秒数
  const SWEEP_PHOTONS = 30; // 掃引のとき、1つの周波数で送る光子の数

  // 吸収線の幅(半値全幅)。上準位の寿命で決まる
  const widthOf = (life: number): number => 1 / (2 * Math.PI * life);
  // ずれ d の光子が吸収される確率(ローレンツ型)
  const absorbProb = (d: number, life: number): number => PEAK / (1 + ((2 * d) / widthOf(life)) ** 2);
  const binOf = (d: number): number => Math.max(0, Math.min(BINS - 1, Math.round((d + F_MAX) / BIN)));

  type Phase = "wait" | "toAtom" | "toDetector" | "excited";

  const setup = (root: HTMLElement) => {
    const q = <T extends HTMLElement>(role: string) => root.querySelector<T>(`[data-role="${role}"]`)!;
    const freqIn = q<HTMLInputElement>("freq");
    const lifeIn = q<HTMLInputElement>("life");
    const sweepBtn = q<HTMLButtonElement>("sweep");
    const canvas = q<HTMLCanvasElement>("canvas");
    const readout = q<HTMLParagraphElement>("readout");
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    const W = canvas.width;

    const sent: number[] = new Array(BINS).fill(0);
    const passed: number[] = new Array(BINS).fill(0);

    // 1個ずつ送る光子の状態
    let phase: Phase = "wait";
    let timer = 0.3; // wait / excited の残り時間(秒)
    let pos = 0; // 光子の位置(0〜1)
    let photonD = 0; // 飛んでいる光子の周波数のずれ
    let detectorFlash = 0;
    const glows: { x: number; y: number; vx: number; vy: number; age: number }[] = []; // 原子が出した光

    let sweeping = false;
    let sweepTimer = 0;

    const freq = () => Number(freqIn.value);
    const life = () => Number(lifeIn.value);

    const clear = () => {
      sent.fill(0);
      passed.fill(0);
    };

    // 画面上の位置
    const SRC = 320;
    const ATOM = 590;
    const DET = 850;
    const BEAM_Y = 115;
    const LOW_Y = 185;
    const UP_Y = 80;
    const E_PX = 11; // 準位の図で、周波数のずれ1あたりのピクセル数

    const advance = (dt: number) => {
      detectorFlash = Math.max(0, detectorFlash - dt * 4);
      for (const g of glows) {
        g.x += g.vx * dt;
        g.y += g.vy * dt;
        g.age += dt;
      }
      while (glows.length && glows[0].age > 0.7) glows.shift();

      if (sweeping) {
        // 掃引: 周波数を少しずつ動かしながら、光子をまとめて送る
        sweepTimer += dt;
        while (sweepTimer > 0.06) {
          sweepTimer -= 0.06;
          let d = freq() + BIN;
          if (d > F_MAX + 1e-9) d = -F_MAX;
          freqIn.value = d.toFixed(1);
          const p = absorbProb(d, life());
          let through = 0;
          for (let i = 0; i < SWEEP_PHOTONS; i++) if (Math.random() >= p) through++;
          sent[binOf(d)] += SWEEP_PHOTONS;
          passed[binOf(d)] += through;
        }
        return;
      }

      if (phase === "wait") {
        timer -= dt;
        if (timer <= 0) {
          phase = "toAtom";
          pos = 0;
          photonD = freq();
        }
      } else if (phase === "toAtom") {
        pos += dt / 0.55;
        if (pos >= 1) {
          sent[binOf(photonD)]++;
          if (Math.random() < absorbProb(photonD, life())) {
            // 吸収: 原子は、寿命を平均とする時間だけ、上準位にとどまる
            phase = "excited";
            timer = -Math.log(1 - Math.random()) * life() * LIFE_SECONDS;
          } else {
            phase = "toDetector";
            pos = 0;
          }
        }
      } else if (phase === "toDetector") {
        pos += dt / 0.5;
        if (pos >= 1) {
          passed[binOf(photonD)]++;
          detectorFlash = 1;
          phase = "wait";
          timer = 0.12;
        }
      } else {
        timer -= dt;
        if (timer <= 0) {
          // 下準位に戻るときに出す光は、検出器とは別の向きに飛ぶ
          const angle = ((40 + Math.random() * 100) * Math.PI) / 180;
          const sign = Math.random() < 0.5 ? -1 : 1;
          glows.push({ x: ATOM, y: BEAM_Y, vx: Math.cos(angle) * 170, vy: sign * Math.sin(angle) * 170, age: 0 });
          phase = "wait";
          timer = 0.15;
        }
      }
    };

    // 光子(短い波のかたまり)。周波数が高いほど、波が細かい
    const drawPhoton = (x: number, y: number, d: number, alpha: number) => {
      const waveLength = 14 - d * 1.5;
      ctx.strokeStyle = `rgba(255, 110, 90, ${alpha})`;
      ctx.lineWidth = 2;
      ctx.beginPath();
      for (let i = -18; i <= 18; i++) {
        const envelope = Math.exp(-(i * i) / 120);
        const py = y - Math.sin((i / waveLength) * 2 * Math.PI) * 9 * envelope;
        if (i === -18) ctx.moveTo(x + i, py);
        else ctx.lineTo(x + i, py);
      }
      ctx.stroke();
    };

    const draw = () => {
      const d = freq();
      const tau = life();
      const gamma = widthOf(tau);
      const p = absorbProb(d, tau);
      q<HTMLOutputElement>("freq-out").value = (d > 0 ? "+" : "") + d.toFixed(1);
      q<HTMLOutputElement>("life-out").value = tau.toFixed(2);
      const excited = !sweeping && phase === "excited";

      ctx.fillStyle = "#0b0b0f";
      ctx.fillRect(0, 0, W, canvas.height);
      ctx.font = "13px sans-serif";
      ctx.textBaseline = "alphabetic";

      // --- 左上: エネルギー準位 ---
      ctx.fillStyle = "#c8c8d0";
      ctx.textAlign = "center";
      ctx.fillText("原子のエネルギー準位", 135, 18);
      // 上準位: 寿命が短いほど、エネルギーがぼやける
      for (let dy = -46; dy <= 46; dy++) {
        const a = 1 / (1 + ((2 * dy) / E_PX / gamma) ** 2);
        if (a < 0.03) continue;
        ctx.fillStyle = `rgba(255, 216, 77, ${Math.min(1, a) * 0.85})`;
        ctx.fillRect(60, UP_Y + dy, 150, 1);
      }
      ctx.fillStyle = "#ffd84d";
      ctx.fillRect(60, LOW_Y - 1, 150, 2);
      ctx.fillStyle = "#c8c8d0";
      ctx.textAlign = "left";
      ctx.fillText("上準位", 216, UP_Y + 4);
      ctx.fillText("下準位", 216, LOW_Y + 4);
      // 準位の差(= h × f0)
      ctx.strokeStyle = "#8a8a96";
      ctx.lineWidth = 1;
      ctx.setLineDash([3, 3]);
      ctx.beginPath();
      ctx.moveTo(42, UP_Y);
      ctx.lineTo(42, LOW_Y);
      ctx.stroke();
      ctx.setLineDash([]);
      ctx.save();
      ctx.translate(30, (UP_Y + LOW_Y) / 2);
      ctx.rotate(-Math.PI / 2);
      ctx.textAlign = "center";
      ctx.fillText("差 = h × f₀", 0, 0);
      ctx.restore();
      // 光子のエネルギーの矢印
      const tip = UP_Y - d * E_PX;
      ctx.strokeStyle = "#ff6e5a";
      ctx.fillStyle = "#ff6e5a";
      ctx.lineWidth = 2.5;
      ctx.beginPath();
      ctx.moveTo(100, LOW_Y - 2);
      ctx.lineTo(100, tip + 8);
      ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(100, tip);
      ctx.lineTo(94, tip + 10);
      ctx.lineTo(106, tip + 10);
      ctx.closePath();
      ctx.fill();
      ctx.textAlign = "center";
      ctx.fillText("光子のエネルギー", 100, LOW_Y + 20);
      // 電子
      ctx.fillStyle = "#6fb7ff";
      ctx.beginPath();
      ctx.arc(170, excited ? UP_Y : LOW_Y, 7, 0, 2 * Math.PI);
      ctx.fill();

      // --- 右上: 光子の通り道 ---
      ctx.fillStyle = "#c8c8d0";
      ctx.textAlign = "center";
      ctx.fillText("レーザー", SRC - 15, BEAM_Y - 28);
      ctx.fillText("原子", ATOM, BEAM_Y - 34);
      ctx.fillText("検出器", DET + 12, BEAM_Y - 28);
      ctx.fillStyle = "#3a3a46";
      ctx.fillRect(SRC - 30, BEAM_Y - 16, 30, 32);
      ctx.fillStyle = detectorFlash > 0 ? `rgba(255, 216, 77, ${0.3 + 0.7 * detectorFlash})` : "#3a3a46";
      ctx.fillRect(DET, BEAM_Y - 20, 25, 40);
      ctx.strokeStyle = "#2a2a34";
      ctx.lineWidth = 1;
      ctx.setLineDash([2, 6]);
      ctx.beginPath();
      ctx.moveTo(SRC, BEAM_Y);
      ctx.lineTo(DET, BEAM_Y);
      ctx.stroke();
      ctx.setLineDash([]);

      if (sweeping) {
        // 掃引中は、光子をまとめて送っているので、光の帯で表す
        ctx.lineWidth = 4;
        ctx.strokeStyle = "rgba(255, 110, 90, 0.8)";
        ctx.beginPath();
        ctx.moveTo(SRC, BEAM_Y);
        ctx.lineTo(ATOM - 16, BEAM_Y);
        ctx.stroke();
        ctx.strokeStyle = `rgba(255, 110, 90, ${0.8 * (1 - p)})`;
        ctx.beginPath();
        ctx.moveTo(ATOM + 16, BEAM_Y);
        ctx.lineTo(DET, BEAM_Y);
        ctx.stroke();
      } else if (phase === "toAtom") {
        drawPhoton(SRC + pos * (ATOM - SRC), BEAM_Y, photonD, 1);
      } else if (phase === "toDetector") {
        drawPhoton(ATOM + pos * (DET - ATOM), BEAM_Y, photonD, 1);
      }
      for (const g of glows) {
        ctx.fillStyle = `rgba(255, 216, 77, ${Math.max(0, 1 - g.age / 0.7)})`;
        ctx.beginPath();
        ctx.arc(g.x, g.y, 4, 0, 2 * Math.PI);
        ctx.fill();
      }
      // 原子(上準位にいるあいだは光らせる)
      const glow = sweeping ? p : excited ? 1 : 0;
      if (glow > 0) {
        const grad = ctx.createRadialGradient(ATOM, BEAM_Y, 6, ATOM, BEAM_Y, 34);
        grad.addColorStop(0, `rgba(255, 216, 77, ${0.8 * glow})`);
        grad.addColorStop(1, "rgba(255, 216, 77, 0)");
        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.arc(ATOM, BEAM_Y, 34, 0, 2 * Math.PI);
        ctx.fill();
      }
      ctx.fillStyle = "#2c5fa8";
      ctx.strokeStyle = "#6fb7ff";
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.arc(ATOM, BEAM_Y, 15, 0, 2 * Math.PI);
      ctx.fill();
      ctx.stroke();
      // いまの周波数で送った数と届いた数
      const bin = binOf(d);
      ctx.fillStyle = "#c8c8d0";
      ctx.textAlign = "center";
      ctx.fillText(
        sweeping
          ? `1つの周波数につき、光子を${SWEEP_PHOTONS}個ずつ送っています`
          : excited
            ? "吸収されました。原子は上準位にいます"
            : "",
        ATOM,
        BEAM_Y + 62,
      );
      ctx.fillText(`この周波数で送った光子 ${sent[bin]}個 / 届いた光子 ${passed[bin]}個`, ATOM, BEAM_Y + 84);

      // --- 下: 吸収線の記録 ---
      const gl = 70;
      const gr = W - 30;
      const gt = 250;
      const gb = 385;
      const xOf = (v: number) => gl + ((v + F_MAX) / (2 * F_MAX)) * (gr - gl);
      const yOf = (t: number) => gb - t * (gb - gt);
      ctx.strokeStyle = "#5a5a66";
      ctx.lineWidth = 1;
      ctx.strokeRect(gl + 0.5, gt + 0.5, gr - gl, gb - gt);
      ctx.fillStyle = "#c8c8d0";
      ctx.textAlign = "left";
      ctx.fillText("検出器に届いた光子の割合", gl, gt - 10);
      ctx.textAlign = "right";
      ctx.fillText("100%", gl - 6, gt + 10);
      ctx.fillText("0%", gl - 6, gb);
      ctx.fillText("低い ← 光の周波数 → 高い", gr, gb + 20);
      ctx.textAlign = "center";
      ctx.fillText("f₀(遷移周波数)", xOf(0), gb + 20);
      ctx.strokeStyle = "#3a3a46";
      ctx.beginPath();
      ctx.moveTo(xOf(0) + 0.5, gt);
      ctx.lineTo(xOf(0) + 0.5, gb);
      ctx.stroke();
      // 光子を無限に送ったときの曲線
      ctx.strokeStyle = "#8a8a96";
      ctx.setLineDash([5, 4]);
      ctx.beginPath();
      for (let px = gl; px <= gr; px++) {
        const v = ((px - gl) / (gr - gl)) * 2 * F_MAX - F_MAX;
        const y = yOf(1 - absorbProb(v, tau));
        if (px === gl) ctx.moveTo(px, y);
        else ctx.lineTo(px, y);
      }
      ctx.stroke();
      ctx.setLineDash([]);
      // 幅(くぼみの深さが半分になるところの幅)
      const halfY = yOf(1 - PEAK / 2);
      ctx.strokeStyle = "#6fb7ff";
      ctx.fillStyle = "#6fb7ff";
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(xOf(-gamma / 2), halfY);
      ctx.lineTo(xOf(gamma / 2), halfY);
      ctx.stroke();
      ctx.textAlign = "left";
      ctx.fillText("幅", xOf(gamma / 2) + 8, halfY + 4);
      // 記録した点
      ctx.fillStyle = "#ffd84d";
      for (let i = 0; i < BINS; i++) {
        if (sent[i] === 0) continue;
        ctx.beginPath();
        ctx.arc(xOf(i * BIN - F_MAX), yOf(passed[i] / sent[i]), 3, 0, 2 * Math.PI);
        ctx.fill();
      }
      // いまの周波数
      ctx.strokeStyle = "#ff6e5a";
      ctx.lineWidth = 2;
      ctx.beginPath();
      ctx.moveTo(xOf(d), gt);
      ctx.lineTo(xOf(d), gb);
      ctx.stroke();

      // --- 説明 ---
      const where =
        Math.abs(d) < 0.05
          ? "光の周波数は、遷移周波数 f₀ とちょうど同じです。"
          : `光の周波数は、遷移周波数 f₀ より ${Math.abs(d).toFixed(1)} だけ${d > 0 ? "高い" : "低い"}状態です。`;
      const rate = Math.round(p * 100);
      const absorb =
        rate >= 1
          ? `この周波数では、光子100個のうち約${rate}個が吸収されます。`
          : "この周波数では、光子はほとんど吸収されず、原子を通り抜けます。";
      let clock = "";
      if (tau >= 0.3) clock = "寿命が長いので、吸収線は細く、中心の周波数を正確に決められます。よい時計には、寿命の長い遷移を選びます。";
      else if (tau <= 0.08) clock = "寿命が短いので、上準位のエネルギーがぼやけ、吸収線は太くなります。中心がどこかを、決めにくくなります。";
      readout.textContent = `${where}${absorb}上準位の寿命 = ${tau.toFixed(2)} のとき、吸収線の幅 = 1 ÷ (2π × 寿命) = ${gamma.toFixed(2)}。${clock}`;
    };

    let last = 0;
    const loop = (time: number) => {
      // 折りたたまれて見えていない間は、計算を止める
      if (root.offsetParent !== null) {
        const dt = Math.min(0.05, last ? (time - last) / 1000 : 0);
        advance(dt);
        draw();
      }
      last = time;
      requestAnimationFrame(loop);
    };

    freqIn.addEventListener("input", draw);
    lifeIn.addEventListener("input", () => {
      // 寿命を変えると吸収線の形が変わるので、記録を消す
      clear();
      draw();
    });
    sweepBtn.addEventListener("click", () => {
      sweeping = !sweeping;
      sweepBtn.textContent = sweeping ? "掃引を止める" : "周波数を自動で動かす(掃引)";
      phase = "wait";
      timer = 0.3;
    });
    q<HTMLButtonElement>("clear").addEventListener("click", () => {
      clear();
      draw();
    });
    draw();
    requestAnimationFrame(loop);
  };

  document.querySelectorAll<HTMLElement>('[data-sim-root="absorption"]').forEach(setup);
</script>
