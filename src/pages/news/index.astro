---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { withBase } from "../../utils/url";

const news = (await getCollection("news", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const formatDate = (d: Date) =>
  d.toLocaleDateString("ja-JP", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout title="ニュース" description="研究室からのお知らせ・技術紹介の一覧です。">
  <h1>ニュース</h1>

  {
    news.length === 0 ? (
      <p>お知らせはまだありません。</p>
    ) : (
      <ul class="card-list">
        {news.map((post) => (
          <li class="card">
            <p class="card__meta">{formatDate(post.data.date)}</p>
            <h2 class="card__title">
              <a href={withBase(`/news/${post.id}/`)}>{post.data.title}</a>
            </h2>
            {post.data.excerpt && <p>{post.data.excerpt}</p>}
            {post.data.tags.length > 0 && (
              <p>
                {post.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </p>
            )}
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>
