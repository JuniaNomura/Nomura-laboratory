---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { withBase } from "../../utils/url";
import { loadYaml } from "../../utils/data";

// researchmap から自動で取り込んだ受賞と委員会(scripts/fetch-researchmap.mjs が毎日更新する)
interface Profile {
  updated?: string;
  awards?: { date?: string; name: string; association?: string }[];
  committees?: { period?: string; name: string; association?: string }[];
}
const profileOf = (permalink?: string): Profile =>
  permalink ? loadYaml<Profile>(`src/data/researchmap/${permalink}.yaml`, {}) : {};

const allMembers = await getCollection("members");

type Member = CollectionEntry<"members">;
const byOrder = (a: Member, b: Member) => a.data.order - b.data.order;

const faculty = allMembers
  .filter((m) => !m.data.graduated && (m.data.role === "faculty" || m.data.role === "staff"))
  .sort(byOrder);
const students = allMembers
  .filter((m) => !m.data.graduated && m.data.role === "student")
  .sort(byOrder);
const alumni = allMembers.filter((m) => m.data.graduated).sort(byOrder);

// 教員の紹介(経歴・受賞・委員会)。どれか1つでもある教員だけ表示する
const profiles = faculty
  .map((member) => ({ member, ...profileOf(member.data.permalink) }))
  .filter((p) => p.member.data.career.length > 0 || p.member.data.qualifications.length > 0 || (p.awards?.length ?? 0) > 0 || (p.committees?.length ?? 0) > 0);

const groups = [
  { label: "教員", members: faculty },
  { label: "学生", members: students },
  { label: "卒業生・修了生", members: alumni },
].filter((g) => g.members.length > 0);
---

<BaseLayout title="メンバー" description="研究室に在籍するメンバーの紹介です。">
  <h1>メンバー</h1>

  {
    groups.map((group) => (
      <section>
        <h2>{group.label}</h2>
        <ul class="member-grid">
          {group.members.map((member) => (
            <li class="member-card">
              {member.data.photo && (
                <img class="member-card__photo" src={withBase(member.data.photo)} alt={member.data.nameJa} />
              )}
              <p class="member-card__name">
                {member.data.nameJa}
                {member.data.grade && ` (${member.data.grade})`}
              </p>
                            {member.data.nameEn && <p class="member-card__name-en">{member.data.nameEn}</p>}
                                          {(member.data.joinDate || member.data.graduationDate) && (
                <p class="member-card__period">
                  {member.data.joinDate && `${member.data.joinDate} 加入`}
                  {member.data.joinDate && member.data.graduationDate && " 〜 "}
                  {member.data.graduationDate && `${member.data.graduationDate} 卒業・修了`}
                </p>
              )}
              {member.data.afterCareer && (
                <p class="member-card__detail">
                  進路: {member.data.afterCareer}
                  {member.data.industry && ` (${member.data.industry})`}
                </p>
              )}
              {member.data.qualifications.length > 0 && !faculty.includes(member) && (
                <p class="member-card__detail">資格: {member.data.qualifications.join("、")}</p>
              )}
              {member.data.awards.length > 0 && (
                <ul class="member-card__awards">
                  {member.data.awards.map((award) => (
                    <li>{award}</li>
                  ))}
                </ul>
              )}
              {member.data.positionJa && <p class="member-card__role">{member.data.positionJa}</p>}
              {member.data.permalink && (
                <p>
                  <a href={`https://researchmap.jp/${member.data.permalink}`} target="_blank" rel="noopener">
                    researchmap
                  </a>
                </p>
              )}
            </li>
          ))}
        </ul>
        {group.label === "教員" &&
          profiles.map((p) => (
            <div class="faculty-profile">
              <h3>
                {p.member.data.nameJa}
                {p.member.data.positionJa && ` (${p.member.data.positionJa})`}
              </h3>
              {p.member.data.career.length > 0 && (
                <>
                  <h4>経歴</h4>
                  <dl class="faculty-profile__list">
                    {p.member.data.career.map((c) => (
                      <>
                        <dt>{c.period}</dt>
                        <dd>{c.text}</dd>
                      </>
                    ))}
                  </dl>
                </>
              )}
              {p.member.data.qualifications.length > 0 && (
                <>
                  <h4>免許・資格</h4>
                  <ul class="faculty-profile__plain">
                    {p.member.data.qualifications.map((q) => (
                      <li>{q}</li>
                    ))}
                  </ul>
                </>
              )}
              {(p.awards?.length ?? 0) > 0 && (
                <details class="faculty-profile__fold">
                  <summary>受賞({p.awards?.length}件)</summary>
                  <dl class="faculty-profile__list">
                    {p.awards?.map((a) => (
                      <>
                        <dt>{a.date}</dt>
                        <dd>
                          {a.name}
                          {a.association && `(${a.association})`}
                        </dd>
                      </>
                    ))}
                  </dl>
                </details>
              )}
              {(p.committees?.length ?? 0) > 0 && (
                <details class="faculty-profile__fold">
                  <summary>委員会・学会活動({p.committees?.length}件)</summary>
                  <dl class="faculty-profile__list">
                    {p.committees?.map((c) => (
                      <>
                        <dt>{c.period}</dt>
                        <dd>
                          {c.name}
                          {c.association && `(${c.association})`}
                        </dd>
                      </>
                    ))}
                  </dl>
                </details>
              )}
              {p.updated && p.member.data.permalink && (
                <p class="faculty-profile__note">
                  受賞と委員会・学会活動は、
                  <a href={`https://researchmap.jp/${p.member.data.permalink}`} target="_blank" rel="noopener">
                    researchmap
                  </a>
                  から自動で取り込んでいます({p.updated} 更新)。
                </p>
              )}
            </div>
          ))}
      </section>
    ))
  }
</BaseLayout>
