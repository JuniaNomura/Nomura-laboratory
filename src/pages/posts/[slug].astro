---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { withBase } from "../../utils/url";
import { isVisible } from "../../utils/visibility";
import { postKindLabel, formatDate } from "../../utils/posts";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => isVisible(data));
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={post.data.title} description={post.data.excerpt}>
  <article>
    {import.meta.env.DEV && post.data.draft && (
      <p class="notice">プレビュー表示です(下書きのため、公開サイトには表示されません)。</p>
    )}
    <p class="card__meta">
      <span class="tag">{postKindLabel(post.data.kind)}</span>
      {formatDate(post.data.date)}
      {post.data.author && ` / ${post.data.author}`}
      {post.data.grade && ` (${post.data.grade})`}
    </p>
    <h1>{post.data.title}</h1>
    <Content />
  </article>
  <p><a href={withBase("/posts/")}>← 学生の記事一覧に戻る</a></p>
</BaseLayout>
