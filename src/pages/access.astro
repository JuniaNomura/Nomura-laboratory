---
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteConfig } from "../config/site";
import { isEmail } from "../utils/contact";
---

<BaseLayout title="アクセス" description="研究室の所在地・連絡先の案内です。">
  <h1>アクセス</h1>

  <section>
    <h2>所在地</h2>
    <p>{siteConfig.addressJa}</p>
  </section>

  <section>
    <h2>連絡先</h2>
    <p>
      {isEmail(siteConfig.contactEmail) ? (
        <a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a>
      ) : (
        siteConfig.contactEmail
      )}
    </p>
  </section>

  <section>
    <h2>交通案内</h2>
    <ul>
      <li>京成本線「京成大久保駅」から、徒歩約10分</li>
      <li>JR「津田沼駅」北口から、京成バスで約10分(4番・5番のりばから乗車し、「日大生産工学部」で下車)</li>
    </ul>
    <p>
      バスの行き先など、詳しくは
      <a href="https://www.cit.nihon-u.ac.jp/access/">日本大学生産工学部の交通案内</a>
      をご覧ください。
    </p>
  </section>
</BaseLayout>
